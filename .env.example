# Copy values into your shell or service environment. This file is not loaded automatically.
# Leave RWD_PASSWORD unset to generate a fresh random access password on startup.
# Set a unique password of 1–1024 UTF-8 bytes (12 or more recommended) when needed.
# RWD_PASSWORD=replace-with-a-unique-long-password

# Network settings can also be passed as --host and --port.
RWD_HOST=127.0.0.1
RWD_PORT=8080

# Optional HTTP/3 WebTransport UDP listener on the same RWD_HOST.
# RWD_HTTP3_PORT=8081
# Optional separate UDP bind when HTTP stays behind a local HTTPS proxy.
# RWD_HTTP3_HOST=0.0.0.0

# Optional exact external origin behind an HTTPS reverse proxy.
# RWD_PUBLIC_ORIGIN=https://remote.example.com
